# photo-to-3d — copy to .env.local (never commit secrets)

# Shared secret for login (cookie session). Required in production.
# Dev default if unset: dev-secret-change-me
APP_SECRET=dev-secret-change-me

# Reconstruction provider: dummy (local vessel) | tripo (stub, not configured)
RECONSTRUCTION_PROVIDER=dummy

# Do NOT set paid API keys for Week2 vessel work.
# TRIPO_API_KEY=  # later
# MESHY_API_KEY=  # paused (cost)

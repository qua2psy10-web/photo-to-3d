# photo-to-3d — copy to .env.local (never commit secrets)

# Shared secret for login (cookie session). Required in production.
# Dev default if unset: dev-secret-change-me
APP_SECRET=dev-secret-change-me

# Reconstruction provider: local (Object Capture on this Mac) | dummy | tripo (stub)
RECONSTRUCTION_PROVIDER=local

# Initial mesh detail on the new-job page: preview | reduced | medium | full | raw.
# The value chosen on that page is what the job runs. This is only the preselected option.
# PHOTOGRAMMETRY_DETAIL=medium

# Optional: probability 0–1 that dummy jobs fail so retry UI can be tested.
# Default 0 (all dummy jobs succeed with the demo cube GLB).
# DUMMY_SIMULATE_FAIL_RATE=0

# Optional override for SQLite + uploads + models (tests use this).
# PHOTO_TO_3D_DATA_DIR=

# Paid APIs are out of scope for this slice. Do not set:
# TRIPO_API_KEY=
# MESHY_API_KEY=
